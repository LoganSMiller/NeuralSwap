        "status": "loaded",
        "settings": {
          "schema": 2,
          "theme": "system",
          "lang": "es",
          "groupGamesByStore": true,
          "autoScanDrives": false,
          "folders": [
            "G:\\Games"
          ],
          "excludedRoots": [],
