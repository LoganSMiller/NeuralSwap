    {
      "file": "settings/scan-without-rules-stamp.json",
      "why": "a cached verdict with no detection-generation stamp is dropped so it is rescanned",
      "expect": {
        "status": "loaded",
        "settings": {
          "schema": 2,
          "theme": "system",
          "lang": "en",
          "groupGamesByStore": true,
          "autoScanDrives": false,
          "folders": [],
          "excludedRoots": [],
          "manual": [],
          "hidden": [],
          "posters": {},
          "scans": {},
          "art": {},
          "recents": [],
          "addons": []
        }
      }
