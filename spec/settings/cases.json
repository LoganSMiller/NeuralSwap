{
  "note": "Open each file as the settings store. status is one of fresh|loaded|migrated|recoveredFromBackup|quarantined, or \"refused\" with a code when the file belongs to a newer build. A file that cannot be read must be set aside, never deleted, and never silently replaced with defaults.",
  "schemaVersion": 2,
  "cases": [
    {
      "file": "settings/v1-upstream.json",
      "why": "the upstream library.json layout migrates forward rather than being discarded",
      "expect": {
        "status": "migrated",
        "settings": {
          "schema": 2,
          "theme": "dark",
          "lang": "de",
          "groupGamesByStore": true,
          "autoScanDrives": false,
          "folders": [
            "E:\\SteamLibrary"
          ],
          "excludedRoots": [],
          "manual": [],
          "hidden": [
            "E:\\SteamLibrary\\Skyrim"
          ],
          "posters": {
            "abc123": "C:\\posters\\abc123.png"
          },
          "scans": {},
          "art": {},
          "recents": [],
          "addons": [
            {
              "path": "C:\\builds\\other.addon64",
              "name": "Other",
              "notes": [],
              "enabled": false
            },
            {
              "path": "C:\\builds\\renodx-dlss.addon64",
              "name": null,
              "notes": [],
              "enabled": true
            }
          ]
        }
      }
    },
    {
      "file": "settings/current.json",
      "why": "a file at the current schema loads unchanged",
      "expect": {
        "status": "loaded",
        "settings": {
          "schema": 2,
          "theme": "system",
          "lang": "ja",
          "groupGamesByStore": true,
          "autoScanDrives": false,
          "folders": [
            "D:\\Games"
          ],
          "excludedRoots": [],
          "manual": [],
          "hidden": [],
          "posters": {},
          "scans": {},
          "art": {},
          "recents": [],
          "addons": []
        }
      }
    },
    {
